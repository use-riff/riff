# Always build for SBPF v0: it deploys on every cluster and runs in LiteSVM's
# default runtime. (Anchor 1.x defaults to v3, which LiteSVM rejects.)
ARCH ?= v0

.PHONY: build build-devnet build-passport-devnet test fmt lint clean deploy-devnet deploy-passport-devnet deploy-dbc-devnet idl vectors dbc-fixtures

# riff-dbc's tests run against Meteora's Dynamic Bonding Curve program as
# deployed on mainnet. Its source is under a non-commercial licence, so it's
# downloaded rather than committed; the hash pins the exact build (update it
# on purpose when Meteora upgrades the program).
DBC_PROGRAM_ID := dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
DBC_SO := programs/riff-dbc/tests/fixtures/dynamic_bonding_curve.so
DBC_SHA256 := e2bfc853c1a1778dd8ee40ea9a0f3edf5587442360c57c685e7e3024ad0cad47
# Meteora's DAMM v2, where coins graduate to; same licence, same handling.
DAMM_PROGRAM_ID := cpamdpZCGKUy5JxQXB4dcpGPiikHawvSWAd6mEn1sGG
DAMM_SO := programs/riff-dbc/tests/fixtures/cp_amm.so
DAMM_SHA256 := 967ff9fb161eec2e62f66d2c899100739fb747c445f697b8625c86b31b9a2022

# The programs only. Their interface (IDL) is generated by `make idl`, which
# compiles everything a second time with Anchor's idl-build feature, so
# everyday builds skip it.
build:
	anchor build --arch $(ARCH) --no-idl

# Publish the program's interface (IDL + TypeScript types) in idl/, so
# clients can use it without building Rust. CI fails if it's stale.
idl:
	mkdir -p idl
	anchor idl build -p riff -o idl/riff.json -t idl/riff.ts
	anchor idl build -p riff_passport -o idl/riff_passport.json -t idl/riff_passport.ts
	anchor idl build -p riff_dbc -o idl/riff_dbc.json -t idl/riff_dbc.ts
	rm -f idl/*_errors.ts  # also written by Anchor's --out-ts; not part of the published interface

# Regenerate vectors/curve.json from the program's curve math.
vectors:
	cargo test -p riff --test all curve_vectors -- --ignored

# Devnet build of riff (Raydium's devnet addresses), saved as riff-devnet.so
# so it can't be mistaken for the mainnet riff.so. Only riff has devnet
# differences. It builds in its own target directory, so the mainnet build
# (which the tests use) is never switched to devnet and back.
build-devnet:
	CARGO_TARGET_DIR=$(CURDIR)/target/devnet cargo build-sbf --manifest-path programs/riff/Cargo.toml \
	  --arch $(ARCH) --features devnet --sbf-out-dir $(CURDIR)/target/devnet/deploy
	cp target/devnet/deploy/riff.so target/deploy/riff-devnet.so

# The passport's devnet build adds a devnet-only `reset_passport` (for demos
# and tests); the mainnet build never contains it.
build-passport-devnet:
	CARGO_TARGET_DIR=$(CURDIR)/target/devnet cargo build-sbf --manifest-path programs/riff-passport/Cargo.toml \
	  --arch $(ARCH) --features devnet --sbf-out-dir $(CURDIR)/target/devnet/deploy

test: build $(DBC_SO) $(DAMM_SO)
	cargo test

fmt:
	cargo fmt --all

lint:
	cargo clippy --all-targets -- -D warnings

clean:
	anchor clean

# Devnet deployment (keys in ~/.config/riff/devnet, never in the repo).
DEVNET_KEYS ?= $(HOME)/.config/riff/devnet

deploy-devnet: build-devnet
	solana program deploy target/deploy/riff-devnet.so \
	  --program-id target/deploy/riff-keypair.json \
	  --keypair $(DEVNET_KEYS)/deployer.json --url devnet

deploy-passport-devnet: build-passport-devnet
	solana program deploy target/devnet/deploy/riff_passport.so \
	  --program-id target/deploy/riff_passport-keypair.json \
	  --keypair $(DEVNET_KEYS)/deployer.json --url devnet

# riff-dbc has no devnet differences: Meteora's programs have the same
# addresses on devnet and mainnet.
deploy-dbc-devnet: build
	solana program deploy target/deploy/riff_dbc.so \
	  --program-id $(DEVNET_KEYS)/riff-dbc-program.json \
	  --keypair $(DEVNET_KEYS)/deployer.json --url devnet

# Downloads Meteora's programs if they're missing; `make dbc-fixtures`
# refreshes them.
$(DBC_SO):
	solana program dump $(DBC_PROGRAM_ID) $(DBC_SO) --url https://api.mainnet-beta.solana.com
	echo "$(DBC_SHA256)  $(DBC_SO)" | sha256sum -c - || (rm -f $(DBC_SO) && false)

$(DAMM_SO):
	solana program dump $(DAMM_PROGRAM_ID) $(DAMM_SO) --url https://api.mainnet-beta.solana.com
	echo "$(DAMM_SHA256)  $(DAMM_SO)" | sha256sum -c - || (rm -f $(DAMM_SO) && false)

dbc-fixtures:
	rm -f $(DBC_SO) $(DAMM_SO)
	$(MAKE) $(DBC_SO) $(DAMM_SO)
